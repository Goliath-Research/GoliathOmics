            }
          ],
          "default": 3,
          "title": "Min Regions Per Tf"
        },
        "min_targets_per_tf": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 5,
          "title": "Min Targets Per Tf"
