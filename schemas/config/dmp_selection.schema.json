{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DmpSelectionConfig",
  "description": "DMP panel selection from discovery exports (FeatureCuts / elbow).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "selection_mode": {
      "type": "string",
      "enum": ["elbow", "featurecuts_validation"],
      "default": "elbow",
      "description": "Alias: classifier_dmp_selection"
    },
    "classifier_dmp_selection": {
      "type": "string",
      "enum": ["elbow", "featurecuts_validation"]
    },
    "target_balanced_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "featurecuts_max_k_cap": { "type": ["integer", "null"], "minimum": 1 },
    "featurecuts_exhaustive_search": { "type": "boolean", "default": false },
    "featurecuts_max_candidates": { "type": ["integer", "null"], "minimum": 1 },
    "min_core_dmps": { "type": ["integer", "null"], "minimum": 1 },
    "min_selected_dmps": { "type": ["integer", "null"], "minimum": 1 },
    "classifier_export_margin_pct": { "type": "number", "minimum": 0, "default": 0.1 },
    "classifier_export_margin_abs": { "type": "integer", "minimum": 0, "default": 0 },
    "classifier_export_max_dmps": { "type": ["integer", "null"], "minimum": 1 },
    "dynamic_dmp_cutoff_enabled": { "type": "boolean", "default": true },
    "dynamic_dmp_cutoff_relaxation": { "type": "number", "minimum": 0, "default": 1.0 },
    "validation_split_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
    "validation_n_repeats": { "type": "integer", "minimum": 1, "default": 1 },
    "temperature": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
    "export_classifier_pickle": { "type": "boolean", "default": false }
  }
}
