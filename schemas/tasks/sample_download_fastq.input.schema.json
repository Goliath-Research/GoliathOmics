    "AzureFastqSource": {
      "additionalProperties": false,
      "properties": {
        "account": {
          "title": "Account",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cfg.credential.content_hash; workers refresh node-local cache when this changes.",
          "title": "Contenthash"
        },
        "credentialName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cfg.credential name bound at expand time.",
          "title": "Credentialname"
        },
        "credentialVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Published credential version bound into task JSON.",
          "title": "Credentialversion"
        },
        "credentials": {
          "discriminator": {
            "mapping": {
              "account_key": "#/$defs/AzureAccountKeyCredentials",
              "azure_key_vault": "#/$defs/AzureKeyVaultCredentials",
              "connection_string": "#/$defs/AzureConnectionStringCredentials",
              "default_credential": "#/$defs/AzureDefaultCredentialCredentials",
              "encrypted_file": "#/$defs/EncryptedFileCredentials"
            },
            "propertyName": "authMode"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AzureAccountKeyCredentials"
            },
            {
              "$ref": "#/$defs/AzureConnectionStringCredentials"
            },
            {
              "$ref": "#/$defs/AzureDefaultCredentialCredentials"
            },
            {
              "$ref": "#/$defs/AzureKeyVaultCredentials"
            },
            {
              "$ref": "#/$defs/EncryptedFileCredentials"
            }
          ],
          "title": "Credentials"
        },
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "lab_ingress",
                "archive",
                "shared"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Admin RBAC hint: lab_ingress vs archive vs shared.",
          "title": "Scope"
        },
        "type": {
          "const": "azure_blob",
          "default": "azure_blob",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "account",
        "container",
        "prefix",
        "credentials"
      ],
      "title": "AzureFastqSource",
      "type": "object"
    },
    "AzureKeyVaultCredentials": {
      "additionalProperties": false,
      "description": "Credential *reference* resolved on the worker via Managed Identity (optional escape hatch).",
      "properties": {
        "authMode": {
          "const": "azure_key_vault",
          "default": "azure_key_vault",
          "title": "Authmode",
          "type": "string"
