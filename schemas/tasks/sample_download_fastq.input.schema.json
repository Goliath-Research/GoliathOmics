  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executionScopeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Baked execution scope id from instance finalize (provenance).",
      "title": "Executionscopeid"
    },
    "fastqSource": {
      "discriminator": {
        "mapping": {
          "azure_blob": "#/$defs/AzureFastqSource",
          "file": "#/$defs/FileFastqSource",
          "s3": "#/$defs/S3FastqSource"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FileFastqSource"
        },
        {
          "$ref": "#/$defs/S3FastqSource"
        },
        {
          "$ref": "#/$defs/AzureFastqSource"
        }
      ],
      "title": "Fastqsource"
    },
    "projectPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Study project path for provenance/logging only; not a config source.",
      "title": "Projectpath"
    },
    "resolvedConfig": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Merged actionConfig slice (may include storage_transfer knobs).",
      "title": "Resolvedconfig"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "sampleRoot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sample identity root (/work/samples/{sampleId}) for FASTQ download and the sample-scoped CAAS store. Alignment products use sampleDir (arm leaf).",
      "title": "Sampleroot"
    },
    "tool": {
      "default": "SampleDownloadFastq",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir",
    "fastqSource"
  ],
  "title": "DownloadFastqTaskInput",
  "type": "object"
