        "authMode": {
          "const": "account_key",
          "default": "account_key",
          "title": "Authmode",
          "type": "string"
        },
        "contentHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "credentialName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentialname"
        },
        "credentialVersion": {
          "anyOf": [
            {
              "type": "string"
