        "credentialVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentialversion"
        }
      },
      "required": [
        "connectionString"
      ],
      "title": "AzureConnectionStringCredentials",
      "type": "object"
    },
    "AzureDefaultCredentialCredentials": {
      "additionalProperties": false,
