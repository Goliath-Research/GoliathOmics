        "contentHash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "credentialName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentialname"
        },
        "credentialVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credentialversion"
        },
        "materializeAs": {
          "anyOf": [
            {
              "enum": [
                "explicit_keys",
                "account_key",
                "connection_string"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional hint for how to interpret a plain-string secret value.",
          "title": "Materializeas"
        },
        "secretName": {
          "description": "Secret name holding JSON or accessKeyId:secret.",
          "title": "Secretname",
          "type": "string"
        },
        "vaultUrl": {
          "description": "Azure Key Vault URL (https://\u2026.vault.azure.net/).",
          "title": "Vaulturl",
          "type": "string"
        }
      },
      "required": [
        "vaultUrl",
        "secretName"
      ],
      "title": "AzureKeyVaultCredentials",
      "type": "object"
    },
    "EncryptedFileCredentials": {
      "additionalProperties": false,
      "description": "Credential *reference* to a Fernet-encrypted local file (node-local / air-gapped).",
