{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "executionScopeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Baked execution scope id from instance finalize (provenance).",
      "title": "Executionscopeid"
    },
    "projectPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Study project path for provenance/logging only; not a config source.",
      "title": "Projectpath"
    },
    "sampleDir": {
      "title": "Sampledir",
      "type": "string"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "sampleRoot": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sample identity root holding shared FASTQs. Delete targets this directory (not the align.* product leaf).",
      "title": "Sampleroot"
    },
    "tool": {
      "default": "SampleDeleteFastqs",
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "sampleId",
    "sampleDir"
  ],
  "title": "DeleteFastqsTaskInput",
  "type": "object"
}
