{
  "$defs": {
    "BiologyWeightConfig": {
      "description": "Per (feature \u00d7 hyper/hypo) weights for biology-aware DMP aggregation in MethylMapper.",
      "properties": {
        "exon_hyper": {
          "default": 1.5,
          "exclusiveMinimum": 0.0,
          "title": "Exon Hyper",
          "type": "number"
        },
        "exon_hypo": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Exon Hypo",
          "type": "number"
        },
        "gene_body_hyper": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Gene Body Hyper",
          "type": "number"
        },
        "gene_body_hypo": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Gene Body Hypo",
          "type": "number"
        },
        "intron_hyper": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Intron Hyper",
          "type": "number"
        },
        "intron_hypo": {
          "default": 0.7,
          "exclusiveMinimum": 0.0,
          "title": "Intron Hypo",
          "type": "number"
        },
        "promoter_hyper": {
          "default": 2.0,
          "exclusiveMinimum": 0.0,
          "title": "Promoter Hyper",
          "type": "number"
        },
        "promoter_hypo": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Promoter Hypo",
          "type": "number"
        },
        "terminator_hyper": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Terminator Hyper",
          "type": "number"
        },
        "terminator_hypo": {
          "default": 0.5,
          "exclusiveMinimum": 0.0,
          "title": "Terminator Hypo",
          "type": "number"
        }
      },
      "title": "BiologyWeightConfig",
      "type": "object"
    },
