{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a file or object written under shared storage (/work).",
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "kind": {
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Name"
    },
    "archiveManifestPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archivemanifestpath"
    },
    "archiveMode": {
      "default": "full",
      "title": "Archivemode",
      "type": "string"
    },
    "archiveSkipped": {
      "default": false,
      "title": "Archiveskipped",
      "type": "boolean"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "capability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    },
    "domainSample": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domainsample"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "exit_code": {
      "default": 0,
      "title": "Exit Code",
      "type": "integer"
    },
    "finished_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At Utc"
    },
    "manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Path"
    },
    "missingConfiguration": {
      "items": {
        "type": "string"
      },
      "title": "Missingconfiguration",
      "type": "array"
    },
    "rejectReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejectreason"
    },
    "remotePrefix": {
      "default": "",
      "title": "Remoteprefix",
      "type": "string"
    },
    "result_code": {
      "default": 0,
      "title": "Result Code",
      "type": "integer"
    },
    "sampleArchived": {
      "default": false,
      "title": "Samplearchived",
      "type": "boolean"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skipReason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipreason"
    },
    "skippedCount": {
      "default": 0,
      "title": "Skippedcount",
      "type": "integer"
    },
    "skippedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Skippedfiles",
      "type": "array"
    },
    "started_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At Utc"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "skipped",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stdout_tail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stdout Tail"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    },
    "uploadedCount": {
      "default": 0,
      "title": "Uploadedcount",
      "type": "integer"
    },
    "uploadedFiles": {
      "items": {
        "type": "string"
      },
      "title": "Uploadedfiles",
      "type": "array"
    }
  },
  "required": [
    "sampleId"
  ],
  "title": "ArchiveSampleTaskOutput",
  "type": "object"
}
