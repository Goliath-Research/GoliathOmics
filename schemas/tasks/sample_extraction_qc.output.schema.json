{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to a file or object written under shared storage (/work).",
      "properties": {
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes"
        },
        "kind": {
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GuardrailsOutput": {
      "additionalProperties": false,
      "properties": {
        "overall_pass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Pass"
        },
        "screening": {
          "$ref": "#/$defs/ScreeningOutput"
        }
      },
      "title": "GuardrailsOutput",
      "type": "object"
    },
    "ScreeningOutput": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "trim_front1": {
          "default": 0,
          "title": "Trim Front1",
          "type": "integer"
        },
        "trim_front2": {
          "default": 0,
          "title": "Trim Front2",
          "type": "integer"
        },
        "trim_tail1": {
          "default": 0,
          "title": "Trim Tail1",
          "type": "integer"
        },
        "trim_tail2": {
          "default": 0,
          "title": "Trim Tail2",
          "type": "integer"
        }
      },
      "title": "ScreeningOutput",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Name"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "capability": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capability"
    },
    "domainSample": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domainsample"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "exit_code": {
      "default": 0,
      "title": "Exit Code",
      "type": "integer"
    },
    "extraction_pass": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extraction Pass"
    },
    "finished_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At Utc"
    },
    "guardrails": {
      "$ref": "#/$defs/GuardrailsOutput"
    },
    "manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Path"
    },
    "qcPath": {
      "title": "Qcpath",
      "type": "string"
    },
    "result_code": {
      "default": 0,
      "title": "Result Code",
      "type": "integer"
    },
    "sampleId": {
      "title": "Sampleid",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At Utc"
    },
    "status": {
      "default": "ok",
      "enum": [
        "ok",
        "skipped",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stdout_tail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stdout Tail"
    },
    "tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    }
  },
  "required": [
    "sampleId",
    "qcPath",
    "guardrails"
  ],
  "title": "ExtractionQcTaskOutput",
  "type": "object"
}
