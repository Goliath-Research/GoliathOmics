{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Shared per-cohort centroid seed built before parallel MC iterations.",
  "properties": {
    "$type": {
      "const": "CentroidSeedGroup",
      "default": "CentroidSeedGroup",
      "title": "$Type",
      "type": "string"
    },
    "addSamples": {
      "items": {
        "type": "string"
      },
      "title": "Addsamples",
      "type": "array"
    },
    "centroidDir": {
      "title": "Centroiddir",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "removeSamples": {
      "items": {
        "type": "string"
      },
      "title": "Removesamples",
      "type": "array"
    }
  },
  "required": [
    "label",
    "centroidDir"
  ],
  "title": "CentroidSeedGroup",
  "type": "object"
}
