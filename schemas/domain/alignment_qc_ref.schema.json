{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Alignment QC JSON artifact and pass/fail gate.",
  "properties": {
    "$type": {
      "const": "AlignmentQcRef",
      "default": "AlignmentQcRef",
      "title": "$Type",
      "type": "string"
    },
    "guardrails": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Guardrails"
    },
    "overallPass": {
      "title": "Overallpass",
      "type": "boolean"
    },
    "qcPath": {
      "title": "Qcpath",
      "type": "string"
    }
  },
  "required": [
    "qcPath",
    "overallPass"
  ],
  "title": "AlignmentQcRef",
  "type": "object"
}
