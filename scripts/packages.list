# Canonical editable package install order for MethylPipeline host/worker nodes.
# One package name per line; blank lines and # comments are ignored.
# Directory names under packages/ (or repo-root for workflow_engine / workers).
# Must include every path dependency of workers/pyproject.toml before workers —
# pip does not honor [tool.uv.sources].
# workflow_engine is the methyl-gateway distribution (console scripts
# methyl-gateway and methyl-reclaim-leases). build_release.sh builds that
# wheel from GoliathApp plus this repo's ops/ and admin/ modules.
methylutils
methylcentroid
methylcluster
methyldetector
methyldmpselect
methylmapper
methylclassifier
methylenricher
methyldiseaseprogression
methylalignmentqc
methylextractionqc
methylpredictor
methylgeneselect
methylgenefeatureselect
methylvalidation
methyldomain
methylfragmentomics
methylderivedmeasures
methyldeconv
methylinfotheory
rnaalignmentqc
omicsfeatures
rnaexpress
proteomicsfeatures
proteomicsqc
workflow_engine
workers
