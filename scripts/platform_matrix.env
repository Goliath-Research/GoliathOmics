# Architecture-specific defaults for MethylPipeline GPU worker nodes.
# Source from bootstrap_goliath.sh / setup_gpu_node.sh after detecting uname -m.
#
# Operators must confirm Parabricks tags on NGC for their GPU generation
# (Hopper/Blackwell vs Ampere vs Grace ARM).

# uname -m -> logical arch key used by scripts
ARCH_KEY_aarch64=aarch64
ARCH_KEY_x86_64=amd64

# MethylExtractor build subdirectory (under build/dynamic/)
METHYL_EXTRACTOR_ARCH_aarch64=arm64
METHYL_EXTRACTOR_ARCH_x86_64=x64

# Clara Parabricks container images (verify on https://catalog.ngc.nvidia.com)
PARABRICKS_IMAGE_amd64=nvcr.io/nvidia/clara/clara-parabricks:4.7.0-1
# ARM64: confirm availability for your SKU; override via METHYL_PARABRICKS_IMAGE if needed
PARABRICKS_IMAGE_aarch64=nvcr.io/nvidia/clara/clara-parabricks:4.7.0-1

# Proteomics GPU tool images (non-Parabricks). Workers run host-native (no --platform),
# so on GH200/Grace (aarch64) these MUST be linux/arm64 or multi-arch images. Confirm an
# arm64 GPU build exists before enabling the capability; else the GPU benefit does not
# materialize on these VMs. Set the matching METHYL_*_IMAGE env from these on each node.
PROTEOMICS_DIANN_IMAGE_amd64=
PROTEOMICS_DIANN_IMAGE_aarch64=
PROTEOMICS_PROSIT_IMAGE_amd64=
PROTEOMICS_PROSIT_IMAGE_aarch64=
PROTEOMICS_CASANOVO_IMAGE_amd64=
PROTEOMICS_CASANOVO_IMAGE_aarch64=
# Sage DDA search (CPU, Apache-2.0). Multi-arch (x86_64 + arm64); no GPU, no page-size caveat.
PROTEOMICS_SAGE_IMAGE_amd64=
PROTEOMICS_SAGE_IMAGE_aarch64=

# methylGrapher(+vg) WGBS pangenome SamplePrep. Built once in CI
# (.github/workflows/methylgrapher-image.yml); workers only pull/load.
# Arm64 image must contain jemalloc=off vg for 64 KB-page kernels.
METHYLGRAPHER_IMAGE_amd64=goliath/methylgrapher:1.70
METHYLGRAPHER_IMAGE_aarch64=goliath/methylgrapher:1.70
