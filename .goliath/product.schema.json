{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Goliath-Research/GoliathOmics/blob/main/.goliath/product.schema.json",
  "title": "Goliath product summary",
  "description": "Machine-readable summary GoliathWeb reads to generate one page per product. Shared with GoliathApp and GoliathAlign.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "tagline",
    "description",
    "category",
    "features",
    "links",
    "related",
    "license",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$",
      "description": "Stable product id used in related and dependsOn."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Two to four sentences of Markdown."
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "description": "Product kind. GoliathOmics uses application."
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "docs", "website"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "docs": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "website": {
          "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      }
    },
    "dependsOn": {
      "type": "array",
      "description": "Optional upstream product ids. Omit the field when the product has no upstream products. Edges point from this product toward these ids.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*$"
      },
      "uniqueItems": true
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
