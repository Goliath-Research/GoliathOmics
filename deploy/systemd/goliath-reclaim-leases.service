[Unit]
Description=Reclaim expired Goliath workflow task leases
Documentation=https://github.com/Goliath-Research/GoliathOmics
After=network-online.target

[Service]
Type=oneshot
User=__USER__
Group=__USER__
EnvironmentFile=-__ENV_FILE__
ExecStart=__ROOT__/venv/bin/methyl-reclaim-leases
NoNewPrivileges=true
