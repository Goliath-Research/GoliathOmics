# Copy to /work/goliath/env/gateway.env (phase 1: Azure SQL Database)
BACKEND_DB=mssql
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DB=MethylPipeline

# SQL authentication (dev / phase 1 without MI):
# AZURE_SQL_USER=sqladmin
# AZURE_SQL_PASSWORD=...

# Production on Azure VM with system- or user-assigned managed identity:
# WF_USE_MANAGED_IDENTITY=1
# AZURE_CLIENT_ID=...   # user-assigned MI only; omit for system-assigned

# Optional: full ODBC connection string override (include LongAsMax=Yes for JSON payloads)
# METHYLPIPELINE_DB=DRIVER={ODBC Driver 18 for SQL Server};SERVER=...;LongAsMax=Yes

# Loopback only when nginx terminates TLS (see deploy/env/gateway.security.env.example).
WF_GATEWAY_HOST=127.0.0.1
WF_GATEWAY_PORT=8080
