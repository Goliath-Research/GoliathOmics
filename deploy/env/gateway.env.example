# Gateway middle-tier environment (PostgreSQL backend example).
# Copy to /work/goliath/env/gateway.env on the control-plane host.
# See docs/goliathapp-extension.md for GOLIATH_* env names and legacy aliases.

BACKEND_DB=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=methylpipeline
PGUSER=methyl_gateway
# PGPASSWORD=          # set via secret store, not committed

# Public worker API base (optional; workers use WORKER_API_BASE / GOLIATH_API_BASE)
# GOLIATH_API_BASE=https://gateway.example/v1

METHYL_API_BIND=0.0.0.0:8080

# Security (see docs/architecture/worker-security-review.md)
GATEWAY_WORKER_IP_BIND=1
GATEWAY_REQUIRE_ARC_ATTEST=0
# GATEWAY_REQUIRE_ENTRA=1
# GATEWAY_ENTRA_TENANT_ID=
# GATEWAY_ENTRA_AUDIENCE=
