# Gateway security and TLS (merge into /work/goliath/env/gateway.env)

# Bind loopback; terminate TLS at nginx
WF_GATEWAY_HOST=127.0.0.1
WF_GATEWAY_PORT=8080

# Worker HMAC verification (must match registration)
# WORKER_TOKEN_HMAC_SECRET=

# Optional hardening (worker-only gateway — no Entra admin routes)
# GATEWAY_REQUIRE_ENTRA=0
# GATEWAY_ENTRA_AUDIENCE=api://methyl-gateway
# GATEWAY_REQUIRE_ARC_ATTEST=0

# nginx TLS paths. scripts/setup_gateway_nginx.sh writes these once and
# reuses them on later deploys. ca.pem is the public certificate workers pin.
# NGINX_SSL_CERT=/etc/ssl/methyl-gateway/fullchain.pem
# NGINX_SSL_KEY=/etc/ssl/methyl-gateway/privkey.pem
# NGINX_SSL_CA=/etc/ssl/methyl-gateway/ca.pem
