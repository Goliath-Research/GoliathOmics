# Copy to /etc/goliath/gateway.env and chmod 600. Do not commit the copy.
# Neon and any other Postgres use the same variables. Password is a secret.

BACKEND_DB=postgres
POSTGRES_HOST=ep-example.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=goliath
POSTGRES_USER=goliath
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require
WF_GATEWAY_HOST=127.0.0.1
WF_GATEWAY_PORT=8080
GOLIATH_ENV=production-work
