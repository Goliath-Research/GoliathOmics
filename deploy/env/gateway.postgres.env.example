# Gateway + Admin CLI — PostgreSQL (copy to /work/goliath/env/gateway.env)
# Used by methyl-gateway systemd and methyl-study-start / deploy scripts.

BACKEND_DB=postgres
WF_SCHEMA=wf

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=methylpipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Full DSN override (wins over discrete POSTGRES_* fields)
# GOLIATH_DATABASE_URL=postgresql://user:pass@host:5432/methylpipeline
# WF_DATABASE_URL=postgresql://user:pass@host:5432/methylpipeline
# Legacy one-release alias:
# METHYLPIPELINE_DB=postgresql://user:pass@host:5432/methylpipeline

# Entra / Azure AD token auth (when supported on your cluster)
# WF_USE_MANAGED_IDENTITY=1
# POSTGRES_USER=<entra-principal>

# Worker security
# WORKER_TOKEN_HMAC_SECRET=generate-with-openssl-rand-hex-32

# Optional tier-1 dual activation (notify on READY; workers wake then claim).
# goliath-test sets WF_WAKE_POSTGRES via deploy_target.sh when dual_activation is true.
# See docs/dual-activation-omics-spike.md.
# WF_WAKE_POSTGRES=1
