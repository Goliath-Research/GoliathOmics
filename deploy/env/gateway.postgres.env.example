# Gateway + Admin CLI — PostgreSQL (copy to /work/goliath/env/gateway.env)
# Used by methyl-gateway systemd and methyl-study-start / deploy scripts.

BACKEND_DB=postgres
WF_SCHEMA=wf

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=methylpipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Full DSN override (wins over discrete fields)
# METHYLPIPELINE_DB=postgresql://user:pass@host:5432/methylpipeline

# Entra / Azure AD token auth (when supported on your cluster)
# WF_USE_MANAGED_IDENTITY=1
# POSTGRES_USER=<entra-principal>

# Worker security
# WORKER_TOKEN_HMAC_SECRET=generate-with-openssl-rand-hex-32
