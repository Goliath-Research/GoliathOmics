# Worker daemon environment (copy to /work/goliath/env/worker.env)
# Loaded by methyl-worker systemd units.

# Gateway base URL — workers call /v1/workers/* only (no admin routes).
WORKER_API_BASE=http://127.0.0.1:8080

# Optional: pin capability when using omnibus methyl-worker.service
# WORKER_CAPABILITY=*

# Stub mode for smoke tests (in-process fake actions; do not use in production)
# WORKER_STUB_EXTERNAL=1

# Site manifest for genome/GTF resolution on workers
METHYL_SITE_CONFIG=/work/site/methyl_site.json

# Profile directory (promoted runtime bundle)
METHYL_PROFILE_DIR=/work/goliath/current/runtime-bundle/domain/profiles

# Sample/align CAAS is default-on under /work/samples/{id}/.caas.
# Reject only if you must force recompute: METHYL_SAMPLE_CAAS_ENABLED=0
# METHYL_SAMPLE_CAAS_ENABLED=0

# --- GPU HBM admission (GH200 / Clara / Mojo Align+QC) ---
# Require this fraction of *total* HBM free before starting a GPU action, and
# again after the action finishes (orphan kill + reclaim). Tunable per site;
# 0.90 leaves ~10% headroom for driver/runtime. Prefer this over absolute GiB.
METHYL_GPU_HBM_FREE_FRACTION=0.90
# Seconds to wait for HBM admit / post-action release.
METHYL_GPU_ALIGN_HBM_WAIT_S=180
# Optional legacy absolute floor (used only when FREE_FRACTION is unset):
# METHYL_GPU_ALIGN_MIN_FREE_GIB=90
# Local flock dir (not NFS) so sister VMs do not block each other:
# METHYL_GPU_ALIGN_LOCK_DIR=/tmp/methyl-gpu-align
