# Copy to /etc/goliath/worker.env (mode 600) or /work/goliath/env/worker.env.
# Workers receive storage credentials and the gateway URL, not the database password.

WORKER_API_BASE=https://gateway.example.com/v1
WORKER_CAPABILITY=
CLUSTER_KEY=goliath
GOLIATH_ENV=production-work

# Backblaze B2 (S3-compatible) shared scratch. Values are secret refs, not keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# GOLIATH_SHARED_BUCKET=example-shared
