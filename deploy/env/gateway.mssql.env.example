# Gateway + Admin CLI — Azure SQL (copy to /work/goliath/env/gateway.env)
# Used by methyl-gateway systemd and methyl-study-start / deploy scripts.

BACKEND_DB=mssql
WF_SCHEMA=wf

# Option A: discrete ODBC fields (password auth)
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DB=methylpipeline
AZURE_SQL_USER=sql_admin
AZURE_SQL_PASSWORD=change-me

# Option B: full connection string override (wins over discrete fields)
# METHYLPIPELINE_DB=Driver={ODBC Driver 18 for SQL Server};Server=...

# Option C: Entra managed identity (gateway on Azure VM / ACA)
# WF_USE_MANAGED_IDENTITY=1
# AZURE_SQL_SERVER=...
# AZURE_SQL_DB=...
# AZURE_SQL_USER=<managed-identity-principal-name>

# Worker security (gateway validates Bearer tokens against wf.worker)
# WORKER_TOKEN_HMAC_SECRET=generate-with-openssl-rand-hex-32
