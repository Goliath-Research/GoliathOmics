{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Goliath-Research/GoliathOmics/deploy/targets/target.schema.json",
  "title": "GoliathOmics deploy target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "rollouts_environment",
    "database"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rollouts_environment": {
      "type": "string",
      "minLength": 1,
      "description": "Cursor Rollouts environment id for this customer target. One environment per customer setup."
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install_root": {
          "type": "string"
        },
        "env_file": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "bind_host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "public_base_url": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "description": "Public TLS in front of the loopback gateway. Omitted mode means self-signed. letsencrypt is optional and needs a domain.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "self-signed",
                "letsencrypt"
              ]
            },
            "san_ip": {
              "type": "string",
              "description": "IPv4 subjectAltName for a self-signed certificate. Defaults to the host of public_base_url when that host is an IP. The certificate is generated once on the gateway and kept across deploys."
            },
            "domain": {
              "type": "string",
              "description": "DNS name for letsencrypt. Not required for an IP-only self-signed gateway."
            },
            "email": {
              "type": "string",
              "description": "ACME contact email for letsencrypt. Not a secret."
            }
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sshHost"
          }
        }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/worker"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "release_dir": {
          "type": "string"
        },
        "pull_parabricks": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sshHost"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "dbname",
        "user"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "postgres",
            "neon",
            "mssql"
          ]
        },
        "project": {
          "type": "string",
          "description": "Neon project id or name. Not a secret."
        },
        "branch": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "description": "Pooled host for the running gateway. Neon pooler hostnames end in -pooler."
        },
        "schema_host": {
          "type": "string",
          "description": "Non-pooled host used for schema apply. DDL and session settings go here when the pooled host is a transaction pooler."
        },
        "port": {
          "type": "integer"
        },
        "dbname": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "$ref": "#/definitions/secretRef"
        },
        "sslmode": {
          "type": "string"
        },
        "channel_binding": {
          "type": "string",
          "description": "libpq channel_binding (PGCHANNELBINDING). Neon test uses require."
        }
      }
    },
    "shared_storage": {
      "$ref": "#/definitions/objectStore"
    },
    "long_term_storage": {
      "$ref": "#/definitions/objectStore"
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apply": {
          "type": "string",
          "enum": [
            "test-bed",
            "none"
          ]
        },
        "goliathapp": {
          "type": "string",
          "enum": [
            "per-release",
            "none"
          ],
          "default": "per-release",
          "description": "per-release: apply the release's GoliathApp sql_pg scripts (goliathapp-sql/) on the first deploy of each release, recorded in wf.schema_release. none: never apply them."
        }
      }
    }
  },
  "definitions": {
    "secretRef": {
      "type": "string",
      "pattern": "^secret:[A-Za-z_][A-Za-z0-9_]*$",
      "description": "Name of an environment variable or /etc/goliath/<target>.env entry. Never a secret value."
    },
    "sshHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ssh"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "ssh": {
          "type": "string",
          "description": "user@host passed to ssh. Not a secret."
        },
        "port": {
          "type": "integer"
        },
        "identity_file": {
          "type": "string",
          "description": "Path to a private key, or secret:NAME whose value is that key. The key is not stored in this file."
        },
        "arch": {
          "type": "string",
          "enum": [
            "aarch64",
            "amd64"
          ],
          "description": "CPU arch for this host. Runtime promote uses it when set on runtime.hosts; otherwise a matching worker ssh is used, then the host is detected."
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "self_provision": {
          "type": "boolean",
          "description": "When true, the worker joins itself (for example a RunPod pool). deploy_target.sh does not SSH to it."
        },
        "provider": {
          "type": "string",
          "enum": [
            "runpod",
            "ssh"
          ]
        },
        "ssh": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "identity_file": {
          "type": "string",
          "description": "Path to a private key, or secret:NAME whose value is that key. The key is not stored in this file."
        },
        "arch": {
          "type": "string",
          "enum": [
            "aarch64",
            "amd64"
          ]
        },
        "capability": {
          "type": "string"
        },
        "gpu": {
          "description": "true when an SSH worker has a GPU, or a GPU spec for a self-provisioned pool.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "memory_gb": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "vcpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory_gb": {
          "type": "integer",
          "minimum": 1,
          "description": "Node RAM in GiB. GPU memory lives on gpu.memory_gb."
        },
        "local_disk_gb": {
          "type": "integer",
          "minimum": 150,
          "description": "Container-local disk in GB for scratch (FASTQs, BAMs, Parabricks tmp, logs, venvs, docker layers). Default 200 when omitted. Minimum 150 so a pod at the floor still has 60 GB free (METHYL_LOCAL_TMP_MIN_GB) after the image, MethylExtractor, GoliathAlign, and the venv are installed. /work is the shared volume and is not this disk. RunPod create sends it as the v2 disk field (v1 containerDiskInGb)."
        },
        "volume_mount": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "install_root": {
          "type": "string"
        },
        "os": {
          "type": "string",
          "description": "Worker OS for offline system-deps bundles (e.g. ubuntu-22.04). Overrides image-based derivation in derive_system_deps_targets.py.",
          "pattern": "^ubuntu-[0-9]+\\.[0-9]+$"
        },
        "registry_auth": {
          "type": "string",
          "minLength": 1,
          "description": "Provider registry credential id for a private worker image (RunPod: container registry credential id). Not a secret value \u2014 the secret lives in the provider console."
        }
      },
      "if": {
        "properties": {
          "self_provision": {
            "const": true
          }
        },
        "required": [
          "self_provision"
        ]
      },
      "then": {
        "required": [
          "name",
          "arch",
          "provider"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "provider": {
                  "const": "runpod"
                }
              },
              "required": [
                "provider"
              ]
            },
            "then": {
              "required": [
                "template",
                "image",
                "volume_mount"
              ]
            }
          }
        ]
      },
      "else": {
        "required": [
          "name",
          "ssh",
          "arch"
        ]
      }
    },
    "objectStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "b2",
            "s3",
            "runpod",
            "qnap",
            "myqnapcloud",
            "none"
          ]
        },
        "bucket": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hot",
              "cold",
              "shared"
            ]
          },
          "description": "Which tiers this endpoint serves. myQNAPCloud on goliath-test serves both hot and cold."
        },
        "access_key_id": {
          "$ref": "#/definitions/secretRef"
        },
        "secret_access_key": {
          "$ref": "#/definitions/secretRef"
        }
      }
    }
  }
}
