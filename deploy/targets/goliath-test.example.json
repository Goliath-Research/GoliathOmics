{
  "name": "goliath-test",
  "rollouts_environment": "goliath-test",
  "gateway": {
    "install_root": "/opt/methyl-gateway",
    "env_file": "/opt/methyl-gateway/env/gateway.env",
    "user": "goliath",
    "bind_host": "127.0.0.1",
    "port": 8080,
    "public_base_url": "https://gateway.example.com/v1",
    "tls": {
      "mode": "self-signed"
    },
    "hosts": [
      {
        "name": "goliath-gateway",
        "ssh": "ubuntu@gateway.example.com"
      }
    ]
  },
  "workers": [
    {
      "name": "worker-amd64",
      "ssh": "ubuntu@worker-amd64.example.com",
      "arch": "amd64",
      "capability": "parabricks.fq2bam",
      "gpu": true,
      "install_root": "/work/goliath"
    },
    {
      "name": "worker-arm64",
      "ssh": "ubuntu@worker-arm64.example.com",
      "arch": "aarch64",
      "capability": "methyl-qc",
      "gpu": true,
      "install_root": "/work/goliath"
    }
  ],
  "runtime": {
    "root": "/work/goliath",
    "release_dir": "/work/goliath/releases/0.0.0-example",
    "pull_parabricks": false
  },
  "database": {
    "kind": "neon",
    "project": "neon-project-placeholder",
    "branch": "main",
    "host": "ep-placeholder.region.aws.neon.tech",
    "port": 5432,
    "dbname": "goliath",
    "user": "goliath",
    "password": "secret:NEON_TEST_PASSWORD",
    "sslmode": "require"
  },
  "shared_storage": {
    "provider": "b2",
    "bucket": "goliath-shared-placeholder",
    "endpoint": "https://s3.us-west-004.backblazeb2.com",
    "region": "us-west-004",
    "access_key_id": "secret:B2_ACCESS_KEY_ID",
    "secret_access_key": "secret:B2_SECRET_ACCESS_KEY"
  },
  "long_term_storage": {
    "provider": "runpod",
    "bucket": "goliath-archive-placeholder",
    "endpoint": "https://s3api-region.runpod.io",
    "host": "example.myqnapcloud.com",
    "share": "goliath-archive",
    "access_key_id": "secret:LONGTERM_ACCESS_KEY_ID",
    "secret_access_key": "secret:LONGTERM_SECRET_ACCESS_KEY"
  },
  "schema": {
    "apply": "test-bed"
  }
}
