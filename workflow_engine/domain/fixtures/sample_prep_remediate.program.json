{
  "programVersion": 2,
  "name": "SamplePrepRemediationPipeline",
  "description": "Batch remediation: re-download FASTQs, R2 front-trim, realign, and final QC before extract. Typed gate variables document the QC bus (catalog bindings populate them).",
  "projectPath": "${var.projectPath}",
  "variables": {
    "qcPass": {
      "schemaRef": "schemas/vars/bool.schema.json",
      "description": "Alignment QC overall_pass from sample.methyl_qc"
    },
    "extractionQcPass": {
      "schemaRef": "schemas/vars/bool.schema.json",
      "description": "Extraction QC overall_pass from sample.extraction_qc"
    },
    "deleteFastqs": {
      "schemaRef": "schemas/vars/bool.schema.json",
      "description": "When true (default), delete local FASTQs after archive or terminal QC. Set false (instance context or actionConfig.sample_prep.delete_fastqs) to retain under /work/samples."
    }
  },
  "phases": [
    {
      "name": "sample_prep_remediate",
      "foreach": {
        "collection": "samples",
        "item": "sample",
        "index": "sampleIndex",
        "parallel": true
      },
      "steps": [
        {
          "action": "sample.download_fastq",
          "node_key": "download_fastq"
        },
        {
          "action": "sample.trim_fastq",
          "node_key": "trim_fastq",
          "with": {
            "trimFront2": "${var.trimFront2}",
            "remediationReason": "SamplePrepRemediationPipeline manifest trim_front2",
            "workflowNodeKey": "trim_fastq"
          }
        },
        {
          "if": "${useWgbsPangenome}",
          "then": [
            {
              "action": "sample.methylgrapher_wgbs_align",
              "node_key": "methylgrapher_wgbs_align"
            }
          ],
          "else": [
            {
              "if": "${usePangenome}",
              "then": [
                {
                  "action": "sample.parabricks_giraffe",
                  "node_key": "parabricks_giraffe"
                }
              ],
              "else": [
                {
                  "action": "sample.parabricks_fq2bam",
                  "node_key": "parabricks_fq2bam"
                }
              ]
            }
          ]
        },
        {
          "action": "sample.methyl_qc",
          "node_key": "methyl_qc",
          "with": {
            "qcAttempt": 2,
            "alignmentPass": "post_trim_realign",
            "qcAttemptReason": "Remediation cohort rerun after trim_front2",
            "workflowNodeKey": "methyl_qc"
          }
        },
        {
          "if": "${qcPass}",
          "then": [
            {
              "if": "${deleteFastqs}",
              "then": [
                {
                  "action": "sample.delete_fastqs",
                  "node_key": "delete_fastqs"
                }
              ]
            },
            {
              "if": "${isCfdna}",
              "then": [
                {
                  "action": "sample.fragmentomics",
                  "node_key": "methyl_fragmentomics"
                }
              ]
            },
            {
              "if": "${useWgbsPangenome}",
              "then": [
                {
                  "action": "sample.methylgrapher_wgbs_extract",
                  "node_key": "methylgrapher_wgbs_extract"
                }
              ],
              "else": [
                {
                  "action": "sample.methyl_extract",
                  "node_key": "methyl_extract"
                }
              ]
            },
            {
              "action": "sample.extraction_qc",
              "node_key": "extraction_qc"
            },
            {
              "if": "${extractionQcPass}",
              "then": [
                {
                  "action": "sample.archive_sample",
                  "node_key": "archive_sample",
                  "with": {
                    "mode": "full",
                    "rejectReason": null
                  }
                },
                {
                  "action": "sample.delete_bam",
                  "node_key": "delete_bam"
                }
              ],
              "else": [
                {
                  "action": "sample.qc_failed",
                  "node_key": "extraction_qc_failed",
                  "with": {
                    "reason": "extraction_qc_failed"
                  }
                }
              ]
            }
          ],
          "else": [
            {
              "if": "${deleteFastqs}",
              "then": [
                {
                  "action": "sample.delete_fastqs",
                  "node_key": "delete_fastqs_fail"
                }
              ]
            },
            {
              "action": "sample.qc_failed",
              "node_key": "qc_failed",
              "with": {
                "reason": "alignment_qc_failed"
              }
            }
          ]
        }
      ]
    }
  ]
}
