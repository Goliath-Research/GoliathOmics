{
  "programVersion": 2,
  "name": "MC_Stability_Residual",
  "description": "Monte Carlo stability with train-only M-value residualization. Deconv + confounder scores once; residualize_fit per iteration on train IDs. Does not change shipped mc_stability.",
  "body": [
    {
      "do": "pipeline.cell_deconvolution",
      "node_key": "cell_deconvolution"
    },
    {
      "do": "pipeline.methylation_confounder_scores",
      "node_key": "methylation_confounder_scores"
    },
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": {
          "ref": "iterations"
        },
        "as": "iteration",
        "parallel": true
      },
      "do": [
        {
          "do": "pipeline.residualize_fit",
          "with": {
            "projectPath": {
              "ref": "iteration.projectPath"
            },
            "outputDir": "${var.iteration.runDir}/residualize"
          },
          "node_key": "residualize_fit"
        },
        {
          "for": {
            "in": {
              "ref": "iteration.centroidGroups"
            },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.contexts"
                },
                "as": "context",
                "parallel": true
              },
              "do": [
                {
                  "for": {
                    "in": {
                      "ref": "project.chromosomes"
                    },
                    "as": "chromosome",
                    "parallel": true
                  },
                  "do": [
                    {
                      "do": "pipeline.centroid",
                      "with": {
                        "group": {
                          "ref": "group.label"
                        },
                        "chromosome": {
                          "ref": "chromosome"
                        },
                        "context": {
                          "ref": "context"
                        },
                        "outputDir": {
                          "ref": "group.centroidDir"
                        },
                        "addSamples": {
                          "ref": "group.addSamples"
                        },
                        "removeSamples": {
                          "ref": "group.removeSamples"
                        },
                        "residualizeCoefDir": "${var.iteration.runDir}/residualize"
                      },
                      "node_key": "centroid"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": {
              "ref": "project.comparisons"
            },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.contexts"
                },
                "as": "context",
                "parallel": true
              },
              "do": [
                {
                  "for": {
                    "in": {
                      "ref": "project.chromosomes"
                    },
                    "as": "chromosome",
                    "parallel": true
                  },
                  "do": [
                    {
                      "do": "pipeline.detector",
                      "with": {
                        "chromosome": {
                          "ref": "chromosome"
                        },
                        "context": {
                          "ref": "context"
                        },
                        "comparison": {
                          "ref": "comparison.label"
                        },
                        "stepOverride": {
                          "detection_mode": "discovery_only",
                          "export_classifier": false
                        }
                      },
                      "node_key": "detect"
                    },
                    {
                      "if": "${runDmpSelection}",
                      "then": [
                        {
                          "do": "pipeline.dmp_select",
                          "with": {
                            "chromosome": {
                              "ref": "chromosome"
                            },
                            "context": {
                              "ref": "context"
                            },
                            "comparison": {
                              "ref": "comparison.label"
                            },
                            "group": {
                              "ref": "comparison.label"
                            }
                          },
                          "node_key": "dmp_select"
                        }
                      ],
                      "else": []
                    }
                  ]
                }
              ]
            },
            {
              "do": "pipeline.mapper",
              "with": {
                "comparison": {
                  "ref": "comparison.label"
                },
                "group": {
                  "ref": "comparison.label"
                }
              },
              "node_key": "mapper"
            }
          ]
        },
        {
          "if": "${runBiomarkerFilter}",
          "then": [
            {
              "do": "validation.biomarker_filter",
              "with": {
                "projectPath": {
                  "ref": "iteration.projectPath"
                },
                "runDir": {
                  "ref": "iteration.runDir"
                }
              },
              "node_key": "biomarker_filter"
            }
          ],
          "else": []
        },
        {
          "if": "${runGeneFeaturecuts}",
          "then": [
            {
              "do": "pipeline.gene_select",
              "with": {
                "projectPath": {
                  "ref": "iteration.projectPath"
                },
                "runDir": {
                  "ref": "iteration.runDir"
                },
                "biomarkerFilter": {
                  "ref": "runBiomarkerFilter"
                }
              },
              "node_key": "gene_select"
            }
          ],
          "else": []
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    }
  ],
  "projectPath": "workflow_engine/domain/checks/buffy_healthy_vs_pca/configs/project_Buffy_healthy_vs_PCa.json"
}
