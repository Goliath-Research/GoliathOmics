{
  "programVersion": 2,
  "name": "MC_Stability_Staged",
  "description": "Staged / one-vs-rest Monte Carlo stability (includes optional gene_feature_select).",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": {
          "ref": "centroidSeedGroups"
        },
        "as": "seedGroup",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "project.contexts"
            },
            "as": "context",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": {
                      "ref": "seedGroup.label"
                    },
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "outputDir": {
                      "ref": "seedGroup.centroidDir"
                    },
                    "addSamples": {
                      "ref": "seedGroup.addSamples"
                    },
                    "removeSamples": {
                      "ref": "seedGroup.removeSamples"
                    }
                  },
                  "node_key": "centroid_seed"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "for": {
        "in": {
          "ref": "iterations"
        },
        "as": "iteration",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "iteration.centroidGroups"
            },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.contexts"
                },
                "as": "context",
                "parallel": true
              },
              "do": [
                {
                  "for": {
                    "in": {
                      "ref": "project.chromosomes"
                    },
                    "as": "chromosome",
                    "parallel": true
                  },
                  "do": [
                    {
                      "do": "pipeline.centroid",
                      "with": {
                        "group": {
                          "ref": "group.label"
                        },
                        "chromosome": {
                          "ref": "chromosome"
                        },
                        "context": {
                          "ref": "context"
                        },
                        "outputDir": {
                          "ref": "group.centroidDir"
                        },
                        "centroidSeedDir": {
                          "ref": "group.centroidSeedDir"
                        },
                        "addSamples": {
                          "ref": "group.addSamples"
                        },
                        "removeSamples": {
                          "ref": "group.removeSamples"
                        }
                      },
                      "node_key": "centroid"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": {
              "ref": "project.comparisons"
            },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.contexts"
                },
                "as": "context",
                "parallel": true
              },
              "do": [
                {
                  "for": {
                    "in": {
                      "ref": "project.chromosomes"
                    },
                    "as": "chromosome",
                    "parallel": true
                  },
                  "do": [
                    {
                      "do": "pipeline.detector",
                      "with": {
                        "chromosome": {
                          "ref": "chromosome"
                        },
                        "context": {
                          "ref": "context"
                        },
                        "comparison": {
                          "ref": "comparison.label"
                        },
                        "stepOverride": {
                          "detection_mode": "discovery_only",
                          "export_classifier": false
                        }
                      },
                      "node_key": "detect"
                    },
                    {
                      "if": "${runDmpSelection}",
                      "then": [
                        {
                          "do": "pipeline.dmp_select",
                          "with": {
                            "chromosome": {
                              "ref": "chromosome"
                            },
                            "context": {
                              "ref": "context"
                            },
                            "comparison": {
                              "ref": "comparison.label"
                            },
                            "group": {
                              "ref": "comparison.label"
                            }
                          },
                          "node_key": "dmp_select"
                        }
                      ],
                      "else": []
                    }
                  ]
                }
              ]
            },
            {
              "do": "pipeline.mapper",
              "with": {
                "comparison": {
                  "ref": "comparison.label"
                },
                "group": {
                  "ref": "comparison.label"
                }
              },
              "node_key": "mapper"
            }
          ]
        },
        {
          "if": "${runBiomarkerFilter}",
          "then": [
            {
              "do": "validation.biomarker_filter",
              "with": {
                "projectPath": {
                  "ref": "iteration.projectPath"
                },
                "runDir": {
                  "ref": "iteration.runDir"
                }
              },
              "node_key": "biomarker_filter"
            }
          ],
          "else": []
        },
        {
          "if": "${runGeneFeaturecuts}",
          "then": [
            {
              "do": "pipeline.gene_select",
              "with": {
                "projectPath": {
                  "ref": "iteration.projectPath"
                },
                "runDir": {
                  "ref": "iteration.runDir"
                },
                "biomarkerFilter": {
                  "ref": "runBiomarkerFilter"
                }
              },
              "node_key": "gene_select"
            }
          ],
          "else": []
        },
        {
          "if": "${runGeneFeatureSelect}",
          "then": [
            {
              "do": "pipeline.gene_feature_select",
              "with": {
                "mapperDir": {
                  "ref": "iteration.runDir"
                },
                "outputDir": {
                  "ref": "iteration.runDir"
                }
              },
              "node_key": "gene_feature_select"
            }
          ],
          "else": []
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    }
  ],
  "projectPath": "workflow_engine/domain/checks/pca1_5_cg/configs/project_Healthy_vs_PCa1-5-CG_smoke.json"
}
