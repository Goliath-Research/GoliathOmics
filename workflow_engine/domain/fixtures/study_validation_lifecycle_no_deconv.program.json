{
  "programVersion": 2,
  "name": "StudyValidationLifecycleNoDeconv",
  "description": "Study validation lifecycle without blood cell-type deconvolution. Same freeze\u2192mapper\u2192derived\u2192info_measures\u2192enricher\u2192model path as StudyValidationLifecycle, omitting the deconvolution node. Used by cfDNA WGBS plasma and EM-Seq targeted assay procedure packs.",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": {
          "ref": "centroidSeedGroups"
        },
        "as": "seedGroup",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "project.contexts"
            },
            "as": "context",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": {
                      "ref": "seedGroup.label"
                    },
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "outputDir": {
                      "ref": "seedGroup.centroidDir"
                    },
                    "addSamples": {
                      "ref": "seedGroup.addSamples"
                    },
                    "removeSamples": {
                      "ref": "seedGroup.removeSamples"
                    }
                  },
                  "node_key": "centroid_seed"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "for": {
        "in": {
          "ref": "iterations"
        },
        "as": "iteration",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "iteration.centroidGroups"
            },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": {
                      "ref": "group.label"
                    },
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "outputDir": {
                      "ref": "group.centroidDir"
                    },
                    "addSamples": {
                      "ref": "group.addSamples"
                    },
                    "removeSamples": {
                      "ref": "group.removeSamples"
                    },
                    "centroidSeedDir": {
                      "ref": "group.centroidSeedDir"
                    }
                  },
                  "node_key": "centroid"
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": {
              "ref": "project.comparisons"
            },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.detector",
                  "with": {
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "comparison": {
                      "ref": "comparison.label"
                    }
                  },
                  "node_key": "detect"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    },
    {
      "do": "validation.stability_freeze_readiness",
      "node_key": "readiness"
    },
    {
      "do": "validation.prepare_freeze_project",
      "node_key": "prepare_freeze"
    },
    {
      "for": {
        "in": {
          "ref": "groups"
        },
        "as": "group",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "project.chromosomes"
            },
            "as": "chromosome",
            "parallel": true
          },
          "do": [
            {
              "do": "pipeline.centroid",
              "with": {
                "group": {
                  "ref": "group.label"
                },
                "chromosome": {
                  "ref": "chromosome"
                },
                "context": {
                  "ref": "context"
                }
              },
              "node_key": "freeze_centroid"
            }
          ]
        }
      ]
    },
    {
      "for": {
        "in": {
          "ref": "project.comparisons"
        },
        "as": "comparison",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "project.chromosomes"
            },
            "as": "chromosome",
            "parallel": true
          },
          "do": [
            {
              "do": "pipeline.detector",
              "with": {
                "chromosome": {
                  "ref": "chromosome"
                },
                "context": {
                  "ref": "context"
                },
                "comparison": {
                  "ref": "comparison.label"
                },
                "fixedDmpPanel": "${var.fixedDmpPanel}"
              },
              "node_key": "freeze_detect"
            }
          ]
        }
      ]
    },
    {
      "do": "pipeline.mapper",
      "node_key": "mapper"
    },
    {
      "do": "pipeline.derived_measures",
      "node_key": "derived_measures"
    },
    {
      "do": "pipeline.info_measures",
      "node_key": "info_measures"
    },
    {
      "do": "pipeline.enricher",
      "node_key": "enricher"
    },
    {
      "do": "validation.finalize_freeze_model_bundle",
      "node_key": "finalize_freeze_model_bundle"
    },
    {
      "do": "pipeline.progression",
      "node_key": "progression"
    },
    {
      "do": "validation.model_mc",
      "node_key": "model_mc"
    },
    {
      "do": "validation.select_best_model",
      "node_key": "select_best_model"
    },
    {
      "do": "validation.post_model_validation",
      "node_key": "post_model_validation"
    }
  ],
  "projectPath": "workflow_engine/domain/checks/pca1_5_cg/configs/project_Healthy_vs_PCa1-5-CG_smoke.json"
}
