{
  "programVersion": 2,
  "name": "DmpSelectOptional",
  "description": "Discovery detector with optional pipeline.dmp_select controlled by ${runDmpSelection}.",
  "projectPath": "/work/projects/prostate-cancer/configs/project_Buffy_healthy_vs_PCa.json",
  "body": [
    {
      "for": {
        "in": { "ref": "project.comparisons" },
        "as": "comparison",
        "parallel": false
      },
      "do": [
        {
          "for": {
            "in": { "ref": "project.chromosomes" },
            "as": "chromosome",
            "parallel": false
          },
          "do": [
            {
              "do": "pipeline.detector",
              "with": {
                "chromosome": { "ref": "chromosome" },
                "context": { "ref": "context" },
                "comparison": { "ref": "comparison.label" },
                "stepOverride": {
                  "detection_mode": "discovery_only",
                  "export_classifier": false
                }
              },
              "node_key": "detect"
            },
            {
              "if": "${runDmpSelection}",
              "then": [
                {
                  "do": "pipeline.dmp_select",
                  "with": {
                    "chromosome": { "ref": "chromosome" },
                    "context": { "ref": "context" },
                    "comparison": { "ref": "comparison.label" },
                    "group": { "ref": "comparison.label" }
                  },
                  "node_key": "dmp_select"
                }
              ],
              "else": []
            }
          ]
        }
      ]
    }
  ]
}
