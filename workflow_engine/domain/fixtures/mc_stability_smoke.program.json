{
  "programVersion": 2,
  "name": "MC_Stability_Smoke",
  "description": "Smoke Monte Carlo stability DomainProgram for CI / compile checks.",
  "body": [
    {
      "do": "validation.plan_iterations",
      "node_key": "plan_iterations"
    },
    {
      "for": {
        "in": {
          "ref": "centroidSeedGroups"
        },
        "as": "seedGroup",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "project.contexts"
            },
            "as": "context",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": {
                      "ref": "seedGroup.label"
                    },
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "outputDir": {
                      "ref": "seedGroup.centroidDir"
                    },
                    "addSamples": {
                      "ref": "seedGroup.addSamples"
                    },
                    "removeSamples": {
                      "ref": "seedGroup.removeSamples"
                    }
                  },
                  "node_key": "centroid_seed"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "for": {
        "in": {
          "ref": "iterations"
        },
        "as": "iteration",
        "parallel": true
      },
      "do": [
        {
          "for": {
            "in": {
              "ref": "iteration.centroidGroups"
            },
            "as": "group",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.centroid",
                  "with": {
                    "group": {
                      "ref": "group.label"
                    },
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "outputDir": {
                      "ref": "group.centroidDir"
                    },
                    "addSamples": {
                      "ref": "group.addSamples"
                    },
                    "removeSamples": {
                      "ref": "group.removeSamples"
                    },
                    "centroidSeedDir": {
                      "ref": "group.centroidSeedDir"
                    }
                  },
                  "node_key": "centroid"
                }
              ]
            }
          ]
        },
        {
          "for": {
            "in": {
              "ref": "project.comparisons"
            },
            "as": "comparison",
            "parallel": true
          },
          "do": [
            {
              "for": {
                "in": {
                  "ref": "project.chromosomes"
                },
                "as": "chromosome",
                "parallel": true
              },
              "do": [
                {
                  "do": "pipeline.detector",
                  "with": {
                    "chromosome": {
                      "ref": "chromosome"
                    },
                    "context": {
                      "ref": "context"
                    },
                    "comparison": {
                      "ref": "comparison.label"
                    }
                  },
                  "node_key": "detect"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "do": "validation.stability",
      "node_key": "stability"
    }
  ],
  "projectPath": "workflow_engine/domain/checks/pca1_5_cg/configs/project_Healthy_vs_PCa1-5-CG_smoke.json"
}
