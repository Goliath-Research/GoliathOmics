      "target_balanced_accuracy": 0.95
    },
    "mapper": {
      "csv_pattern": "dmps-*-discovery.csv"
    },
    "validation": {
      "stability_featurecuts_enabled": true,
      "stability_gene_featurecuts_enabled": true,
      "stability_gene_biomarker_filter_enabled": true,
      "stability_min_balanced_accuracy": 0.95,
      "stability_gene_featurecuts_dmp_source": "discovery"
    },
    "gene_selection": {}
  }
