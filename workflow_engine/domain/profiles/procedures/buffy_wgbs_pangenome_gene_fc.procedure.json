{
  "pipelineProcedure": "buffy_wgbs_pangenome_gene_fc",
  "catalog": {
    "title": "Buffy WGBS pangenome + gene FC",
    "summary": "Default human buffy research (methylGrapher / pangenome_wgbs).",
    "visibility": "operator",
    "lifecycle": "active",
    "family": "specialty"
  },
  "description": "Buffy-coat WGBS with pangenome alignment, read-level informME patterns, Houseman deconvolution covariates, and gene FeatureCuts stability.",
  "pipelineProfile": "samd_research",
  "researchMode": "gene_fc",
  "analyteExpectation": "buffy_coat",
  "libraryProtocol": "wgbs_pangenome",
  "alignmentMode": "pangenome_wgbs",
  "usePangenome": true,
  "useWgbsPangenome": true,
  "samplePrepProgram": "workflow_engine/domain/fixtures/sample_prep.program.json",
  "lifecycleProgram": "workflow_engine/domain/fixtures/study_validation_lifecycle.program.json",
  "runDmpSelection": false,
  "runGeneFeaturecuts": true,
  "stabilityFeaturecutsEnabled": false,
  "stabilityGeneFeaturecutsEnabled": true,
  "actionConfig": {
    "sample_prep": {
      "library_protocol": "wgbs_pangenome",
      "alignment_mode": "pangenome_wgbs"
    },
    "parabricks": {
      "alignment_mode": "pangenome_wgbs"
    },
    "methylgrapher_wgbs": {
      "alignment_mode": "pangenome_wgbs",
      "directional": true,
      "engine": "mojo",
      "align_engine": "gpu_giraffe",
      "gpu_giraffe_fallback": "mojo",
      "giraffe_device": "auto",
      "align_device": "auto",
      "mojo_segments_cache": "/work/cache/mojo_segments",
      "qc_bam_engine": "mojo",
      "qc_bam_fallback": "error",
      "dual_graph_parallel": false,
      "conversion_rate_enabled": true,
      "read_level": {
        "enabled": true,
        "tile_size": 4,
        "gaf_patterns": false
      }
    },
    "methyl_extract": {
      "read_level": {
        "enabled": true,
        "tile_size": 4,
        "gaf_patterns": false
      }
    },
    "alignment_qc": {
      "cycle_screening": {
        "remediate_without_cycles": true,
        "fallback_trim_front": 5,
        "fallback_trim_tail": 0
      },
      "bisulfite_conversion": {
        "enabled": true,
        "source": "sidecar"
      }
    },
    "cell_deconvolution": {
      "method": "houseman",
      "contexts": [
        "CG"
      ],
      "marker_min_coverage": 4,
      "min_marker_fraction": 0.25,
      "use_gpu": true
    },
    "info_measures": {
      "contexts": [
        "CG"
      ],
      "tile_size": 4,
      "ising_enabled": true
    },
    "validation": {
      "dmp_modeling_mode": "raw_pool",
      "gene_modeling_mode": "featurecuts",
      "stability_featurecuts_enabled": false,
      "stability_gene_featurecuts_enabled": true,
      "backend_profiles": {
        "ecdf": {
          "enabled": true,
          "params": {
            "ecdf_second_stage_enabled": true,
            "covariates_path": [
              "{output_base}/cell_fractions/cell_fractions.csv",
              "{output_base}/derived_measures/derived_measures.csv",
              "{output_base}/info_measures/readlevel_measures.csv"
            ]
          }
        }
      }
    }
  }
}
