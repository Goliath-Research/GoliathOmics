      "min_cov": 20,
      "read_level": {
        "enabled": false
      },
      "target_panel_bed": null
    },
    "cell_deconvolution": null,
    "info_measures": null,
    "validation": {
      "dmp_modeling_mode": "raw_pool",
      "gene_modeling_mode": "featurecuts",
      "stability_featurecuts_enabled": false,
      "stability_gene_featurecuts_enabled": true,
      "backend_profiles": {
        "ecdf": {
          "enabled": true,
          "params": {
            "covariates_path": [
              "{output_base}/derived_measures/derived_measures.csv"
            ],
            "covariate_composition_groups": null
          }
        }
      }
    }
  }
