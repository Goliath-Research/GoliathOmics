{
  "pipelineProcedure": "cfdna_emseq_targeted",
  "catalog": {
    "title": "cfDNA EM-Seq targeted",
    "summary": "EM-Seq hybrid-capture panel (BED) for cfDNA.",
    "visibility": "operator",
    "lifecycle": "active",
    "family": "specialty"
  },
  "description": "cfDNA EM-Seq / hybrid-capture targeted procedure (inch-wide, mile-deep). Requires operator-supplied target_panel_bed; elevated min_cov; no genome-wide DMP hunt; no cell deconvolution.",
  "pipelineProfile": "samd_research",
  "researchMode": "gene_fc",
  "analyteExpectation": "cfdna",
  "libraryProtocol": "emseq_targeted",
  "alignmentMode": "linear",
  "usePangenome": false,
  "useEmseqTargeted": true,
  "samplePrepProgram": "workflow_engine/domain/fixtures/sample_prep_emseq.program.json",
  "lifecycleProgram": "workflow_engine/domain/fixtures/study_validation_lifecycle_no_deconv.program.json",
  "runDmpSelection": false,
  "runGeneFeaturecuts": true,
  "stabilityFeaturecutsEnabled": false,
  "stabilityGeneFeaturecutsEnabled": true,
  "actionConfig": {
