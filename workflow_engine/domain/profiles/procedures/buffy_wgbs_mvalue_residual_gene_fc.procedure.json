{
  "pipelineProcedure": "buffy_wgbs_mvalue_residual_gene_fc",
  "catalog": {
    "title": "Buffy WGBS pangenome + M-value residual gene FC",
    "summary": "Opt-in buffy procedure: train-only M-value residualization before centroids/DMPs. Shipped buffy_wgbs_pangenome_gene_fc is unchanged.",
    "visibility": "operator",
    "lifecycle": "active",
    "family": "specialty"
  },
  "description": "Buffy-coat WGBS with pangenome alignment plus train-only M-value residualization (Houseman \u03a9 ALR, smoking, clock, BMI, CRP) before centroid Sx/histograms. gene_importance formula is unchanged; it reports confounder-adjusted host-response. Does not alter the default buffy pangenome procedure.",
  "pipelineProfile": "samd_research",
  "researchMode": "gene_fc",
  "analyteExpectation": "buffy_coat",
  "libraryProtocol": "wgbs_pangenome",
  "alignmentMode": "pangenome_wgbs",
  "usePangenome": true,
  "useWgbsPangenome": true,
  "samplePrepProgram": "workflow_engine/domain/fixtures/sample_prep.program.json",
  "lifecycleProgram": "workflow_engine/domain/fixtures/study_validation_lifecycle_residual.program.json",
  "runDmpSelection": false,
  "runGeneFeaturecuts": true,
  "stabilityFeaturecutsEnabled": false,
  "stabilityGeneFeaturecutsEnabled": true,
  "actionConfig": {
    "sample_prep": {
      "library_protocol": "wgbs_pangenome",
      "alignment_mode": "pangenome_wgbs"
    },
    "parabricks": {
      "alignment_mode": "pangenome_wgbs"
    },
    "methylgrapher_wgbs": {
      "alignment_mode": "pangenome_wgbs",
      "directional": true,
      "engine": "mojo",
      "align_engine": "gpu_giraffe",
      "gpu_giraffe_fallback": "mojo",
      "giraffe_device": "auto",
      "align_device": "auto",
      "mojo_segments_cache": "/work/cache/mojo_segments",
      "qc_bam_engine": "mojo",
      "qc_bam_fallback": "error",
      "dual_graph_parallel": false,
      "conversion_rate_enabled": true,
      "read_level": {
        "enabled": true,
        "tile_size": 4,
        "gaf_patterns": false
      }
    },
    "methyl_extract": {
      "read_level": {
        "enabled": true,
        "tile_size": 4,
        "gaf_patterns": false
      }
    },
    "alignment_qc": {
      "cycle_screening": {
        "remediate_without_cycles": true,
        "fallback_trim_front": 5,
        "fallback_trim_tail": 0
      },
      "bisulfite_conversion": {
        "enabled": true,
        "source": "sidecar"
      }
    },
    "cell_deconvolution": {
      "method": "houseman",
      "contexts": [
        "CG"
      ],
      "marker_min_coverage": 4,
      "min_marker_fraction": 0.25,
      "use_gpu": true
    },
    "info_measures": {
      "contexts": [
        "CG"
      ],
      "tile_size": 4,
      "ising_enabled": true
    },
    "validation": {
      "dmp_modeling_mode": "raw_pool",
      "gene_modeling_mode": "featurecuts",
      "stability_featurecuts_enabled": false,
      "stability_gene_featurecuts_enabled": true,
      "backend_profiles": {
        "ecdf": {
          "enabled": true,
          "params": {
            "ecdf_second_stage_enabled": true,
            "covariates_path": [
              "{output_base}/cell_fractions/cell_fractions.csv",
              "{output_base}/derived_measures/derived_measures.csv",
              "{output_base}/info_measures/readlevel_measures.csv"
            ]
          }
        }
      }
    },
    "methylation_confounder_scores": {
      "output_dir": "{output_base}/confounder_scores",
      "smoking_panel_path": "smoking_ahr_v1.json",
      "age_clock_path": "hannum2013_v1.json",
      "bmi_panel_path": "bmi_adiposity_v1.json",
      "inflammation_panel_path": "crp_inflammation_v1.json",
      "contexts": [
        "CG"
      ],
      "min_coverage": 4,
      "min_sites_fraction": 0.5
    },
    "residualize": {
      "output_dir": "{output_base}/production/residualize",
      "covariates_path": [
        "{output_base}/cell_fractions/cell_fractions.csv",
        "{output_base}/confounder_scores/confounder_scores.csv"
      ],
      "numeric_columns": [
        "smoking_score",
        "age_score",
        "bmi_score",
        "crp_score"
      ],
      "composition_columns": [
        "CD8T",
        "CD4T",
        "NK",
        "Bcell",
        "Mono",
        "Neu"
      ],
      "composition_reference": "Neu",
      "composition_pseudocount": 0.5,
      "variance_threshold": 1e-08,
      "m_value_eps": 1e-06,
      "contexts": [
        "CG"
      ],
      "min_coverage": 4,
      "sample_id_column": "sample_id"
    },
    "centroid": {
      "residualize_coef_dir": "{output_base}/production/residualize"
    },
    "classifier": {
      "residualize_coef_dir": "{output_base}/production/residualize"
    },
    "predictor": {
      "residualize_coef_dir": "{output_base}/production/residualize"
    }
  }
}
