{
  "pipelineProcedure": "cfdna_wgbs_plasma",
  "catalog": {
    "title": "cfDNA WGBS plasma",
    "summary": "Plasma cfDNA WGBS with fragmentomics; no cell deconvolution.",
    "visibility": "operator",
    "lifecycle": "active",
    "family": "specialty"
  },
  "description": "cfDNA WGBS plasma procedure: linear alignment, fragmentomics (analyte merge), gene FeatureCuts, no cell deconvolution. HiTIMED plasma tree is an optional instance overlay, not the default.",
  "pipelineProfile": "samd_research",
  "researchMode": "gene_fc",
  "analyteExpectation": "cfdna",
  "libraryProtocol": "wgbs_linear",
  "alignmentMode": "linear",
  "usePangenome": false,
  "samplePrepProgram": "workflow_engine/domain/fixtures/sample_prep.program.json",
  "lifecycleProgram": "workflow_engine/domain/fixtures/study_validation_lifecycle_no_deconv.program.json",
  "runDmpSelection": false,
  "runGeneFeaturecuts": true,
  "stabilityFeaturecutsEnabled": false,
  "stabilityGeneFeaturecutsEnabled": true,
  "actionConfig": {
    "sample_prep": {
      "library_protocol": "wgbs_linear"
    },
    "parabricks": {
      "alignment_mode": "linear"
    },
    "methyl_extract": {
      "read_level": {
        "enabled": true,
        "tile_size": 4
      }
    },
    "cell_deconvolution": null,
    "info_measures": {
      "contexts": [
        "CG"
      ],
      "tile_size": 4,
      "ising_enabled": true
    },
    "validation": {
      "dmp_modeling_mode": "raw_pool",
      "gene_modeling_mode": "featurecuts",
      "stability_featurecuts_enabled": false,
      "stability_gene_featurecuts_enabled": true,
      "backend_profiles": {
        "ecdf": {
          "enabled": true,
          "params": {
            "covariates_path": [
              "{output_base}/derived_measures/derived_measures.csv",
              "{output_base}/info_measures/readlevel_measures.csv"
            ],
            "covariate_composition_groups": null
          }
        },
        "tabular_sklearn": {
          "params": {
            "covariates_path": [
              "{output_base}/derived_measures/derived_measures.csv",
              "{output_base}/info_measures/readlevel_measures.csv"
            ],
            "covariate_composition_groups": null
          }
        },
        "generative_hybrid": {
          "params": {
            "covariates_path": [
              "{output_base}/derived_measures/derived_measures.csv",
              "{output_base}/info_measures/readlevel_measures.csv"
            ],
            "covariate_composition_groups": null
          }
        }
      }
    }
  }
}
